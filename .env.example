# Copy to .env and fill in. Create the key at app.gnani.ai (API keys page).
# Prisma and Timbre both use this key (X-API-Key-ID header); endpoints default to api.vachana.ai per docs.gnani.ai.
GNANI_API_KEY=
# Optional overrides
# PRISMA_URL=https://api.vachana.ai/stt/v3
# TIMBRE_URL=https://api.vachana.ai/api/v1/tts/inference
# TIMBRE_MODEL=timbre-v3.0
# TIMBRE_VOICE=Shivani
# Evon is published as Hugging Face weights. Host it with evon/kavach_evon_kaggle.ipynb (free Kaggle 2x T4)
# and paste the two lines it prints. Rules still work without it.
EVON_URL=
EVON_API_KEY=
EVON_MODEL=evon
TELEGRAM_BOT_TOKEN=
# Telegram chat id of the son/daughter (send /start to the bot to see it)
GUARDIAN_CHAT_ID=
# Secret the parent's phone automation app sends to /check-recording (any long random string)
KAVACH_UPLOAD_TOKEN=
# Only the first N seconds of a call recording are checked (saves credits)
MAX_AUDIO_S=300
LANGUAGE=hi-IN
ALERT_THRESHOLD=70
CAUTION_THRESHOLD=40
